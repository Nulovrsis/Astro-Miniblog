---
import Layout from "../layouts/Layout.astro";

const pageTitle = "About Me";
const pageDescription = "Learn more about me and this blog.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="space-y-8">
    <div>
      <h1 class="text-4xl font-extrabold">Nulovrsis</h1>
      <p class="mt-2 text-lg italic text-zinc-600 dark:text-zinc-400">
        "一朝悲歌成金曲，愁容骑士更多余。"
      </p>
      <img
        src="/static/banner.jpg"
        alt="Welcome banner"
        class="mx-auto mt-4 w-1/2 rounded-lg shadow-md"
        loading="eager"
      />
      <p class="mt-4"></p>
      <p class="mt-2">记录一些项目的部署学习过程，还有杂思。</p>
    </div>

    <section>
      <div class="mb-6 flex items-center gap-3">
        <img
          src="/static/我有话说.png"
          alt="Profile avatar"
          class="h-10 w-10 rounded-md object-cover shadow-sm"
          loading="eager"
        />
        <h2 class="text-2xl font-bold">Find Me On</h2>
      </div>
      <ul class="flex flex-wrap gap-3">
        <li>
          <a
            href="https://github.com/Nulovrsis"
            class="inline-flex items-center gap-2 rounded-lg bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
          >
            🐙 GitHub
          </a>
        </li>
        <li>
          <a
            href="https://twitter.com/nulovrsis"
            class="inline-flex items-center gap-2 rounded-lg bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
          >
            🕊️ Twitter
          </a>
        </li>
        <li>
          <a
            href="https://steamcommunity.com/id/nulovrsis/"
            class="inline-flex items-center gap-2 rounded-lg bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
          >
            🕹️ Steam
          </a>
        </li>
        <li>
          <a
            href="https://chii.in/user/nulovrsis"
            class="inline-flex items-center gap-2 rounded-lg bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-100 dark:hover:bg-zinc-700"
          >
            🎬 Bangumi
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>
